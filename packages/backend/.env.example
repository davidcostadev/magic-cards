NODE_ENV=development
PORT=3001
JWT_SECRET=dev-secret-change-me
JWT_EXPIRATION=24h

# Database connection string. Dev now uses a REAL Postgres server — point this at a local
# Postgres (e.g. a dedicated `magic_cards` database). Required when NODE_ENV=production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/magic_cards

# Fallback ONLY when DATABASE_URL is unset: an embedded in-process Postgres (PGlite) persisted
# to this directory — no server needed, but it can corrupt on a non-graceful kill (the reason
# dev moved to a real Postgres). Tests always use in-memory PGlite regardless of DATABASE_URL.
DATABASE_PATH=./data/pg

# Comma-separated list of allowed CORS origins (Vite dev server ports)
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# Long random secret that authorizes publishing shared content via /v1/catalog/*
# (x-api-key header). Unset → the catalog is disabled. Min 16 chars.
# CONTENT_API_KEY=change-me-to-a-long-random-value
